.wrangler/

# Scratch area for font originals too large to commit (the 25 MB LXGW TTF).
# Everything scripts/subset-fonts.ts actually reads is committed under
# src/assets/fonts-full/ instead, so subsets can always be rebuilt.
scripts/.fonts/

# Self-hosted Waline server deployment (run locally)
/waline-server/

# Stray file produced by an accidental `> nul` redirect on non-cmd shells
/nul
