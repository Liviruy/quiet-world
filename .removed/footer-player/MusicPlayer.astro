---
import { musicConfig } from '@/config/music'
import { getPageInfo } from '@/utils/page'

const { currentLang } = getPageInfo(Astro.url.pathname)
const labels = currentLang === 'en'
  ? {
      region: 'Music player',
      play: 'Play music',
      pause: 'Pause music',
      progress: 'Music progress',
      volume: 'Volume',
      mute: 'Mute music',
      unmute: 'Restore music volume',
      loadError: 'Unable to load this track',
    }
  : {
      region: '音乐播放器',
      play: '播放音乐',
      pause: '暂停音乐',
      progress: '音乐进度',
      volume: '音量',
      mute: '静音',
      unmute: '恢复音量',
      loadError: '音乐加载失败',
    }
---

{musicConfig.enabled && (
  <div
    class="quiet-music-player"
    data-music-url={musicConfig.track.url}
    data-label-play={labels.play}
    data-label-pause={labels.pause}
    data-label-progress={labels.progress}
    data-label-volume={labels.volume}
    data-label-mute={labels.mute}
    data-label-unmute={labels.unmute}
    data-label-error={labels.loadError}
    role="region"
    aria-label={labels.region}
  >
    <div class="quiet-music-art-wrap">
      <button class="quiet-music-art" type="button" aria-label={labels.play}>
        <span class="quiet-music-cover-char" aria-hidden="true">{musicConfig.track.title.charAt(0)}</span>
        <span class="quiet-music-eq" aria-hidden="true">
          <span /><span /><span />
        </span>
        <span class="quiet-music-art-scrim" aria-hidden="true">
          <svg class="quiet-music-art-icon quiet-music-art-play" viewBox="0 0 24 24">
            <path d="M8.2 5.6a1 1 0 0 1 1.52-.85l9 5.55a1 1 0 0 1 0 1.7l-9 5.55a1 1 0 0 1-1.52-.85Z" fill="currentColor" />
          </svg>
          <svg class="quiet-music-art-icon quiet-music-art-pause" viewBox="0 0 24 24">
            <path d="M8.5 5.5h2.2v13H8.5zM13.3 5.5h2.2v13h-2.2z" fill="currentColor" />
          </svg>
        </span>
      </button>
    </div>

    <div class="quiet-music-copy">
      <div class="quiet-music-track">
        <span class="quiet-music-title">{musicConfig.track.title}</span>
        <span class="quiet-music-artist">{musicConfig.track.artist}</span>
      </div>
      <div class="quiet-music-heading">
        <span class="quiet-music-state" aria-live="polite">0:00 / 0:00</span>
        <span class="quiet-music-volume">
          <button class="quiet-music-volume-button" type="button" aria-label={labels.mute}>
            <svg class="quiet-music-volume-icon quiet-music-volume-high" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="5" cy="12" r="1.35" fill="currentColor" />
              <path d="M9 9.4a4 4 0 0 1 0 5.2m3.8-8.1a8 8 0 0 1 0 11" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.65" />
            </svg>
            <svg class="quiet-music-volume-icon quiet-music-volume-muted" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="5" cy="12" r="1.35" fill="currentColor" />
              <path d="M9 10.2a2.7 2.7 0 0 1 0 3.6m4.2-6.2a6.3 6.3 0 0 1 0 8.8M16.5 7.5l4 9" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.65" />
            </svg>
          </button>
          <span class="quiet-music-volume-slider">
            <span class="quiet-music-volume-track" aria-hidden="true">
              <span class="quiet-music-volume-fill" />
            </span>
            <input class="quiet-music-volume-range" type="range" min="0" max="100" value="70" step="1" aria-label={labels.volume} />
          </span>
        </span>
      </div>
      <button class="quiet-music-progress" type="button" aria-label={labels.progress} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="quiet-music-progress-fill" />
      </button>
    </div>
    <audio class="quiet-music-audio" preload="metadata" aria-hidden="true" />
  </div>
)}

<style>
  /* Apple mini-player look, sharing the /music room page tokens: red key
     color, SF/PingFang stack, glass card, hairline scrubber. */
  .quiet-music-player {
    --qm-accent: #d60017;
    --qm-accent-hover: #a20000;
    --qm-ink: oklch(var(--un-preset-theme-colors-primary));
    --qm-ink-soft: oklch(var(--un-preset-theme-colors-secondary) / 0.62);
    --qm-hairline: oklch(var(--un-preset-theme-colors-secondary) / 0.14);
    --qm-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Hiragino Sans GB', 'Segoe UI', system-ui, sans-serif;
    position: relative;
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    align-items: center;
    column-gap: 0.8rem;
    width: min(100%, 24rem);
    min-height: 4.6rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.1);
    border-radius: 1.25rem;
    background: oklch(var(--un-preset-theme-colors-bg) / 0.72);
    box-shadow: 0 0.8rem 2rem oklch(var(--un-preset-theme-colors-secondary) / 0.14);
    -webkit-backdrop-filter: blur(1.4rem) saturate(1.35);
    backdrop-filter: blur(1.4rem) saturate(1.35);
    font-family: var(--qm-font);
    overflow: hidden;
  }

  html.dark .quiet-music-player {
    --qm-accent: #ff453a;
    --qm-accent-hover: #ff6961;
    --qm-hairline: oklch(var(--un-preset-theme-colors-secondary) / 0.22);
  }

  .quiet-music-art-wrap {
    position: relative;
    width: 3.4rem;
    height: 3.4rem;
  }

  .quiet-music-art {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    padding: 0;
    place-items: center;
    overflow: hidden;
    border: 0;
    border-radius: 0.55rem;
    background:
      radial-gradient(circle at 30% 25%, oklch(from var(--qm-accent) calc(l + 0.14) c h / 0.85), transparent 62%),
      linear-gradient(140deg, oklch(from var(--qm-accent) calc(l + 0.04) c h), oklch(from var(--un-preset-theme-colors-primary) l c h));
    box-shadow: 0 0.3rem 0.7rem oklch(from var(--qm-accent) l c h / 0.28);
    cursor: pointer;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .quiet-music-art:hover {
    transform: translateY(-1px);
    box-shadow: 0 0.45rem 0.9rem oklch(from var(--qm-accent) l c h / 0.34);
  }

  .quiet-music-art:active {
    transform: scale(0.95);
  }

  .quiet-music-art:focus-visible {
    outline: 1px solid oklch(from var(--qm-accent) l c h / 0.7);
    outline-offset: 2px;
  }

  /* Requested playback but still buffering: a gentle breathe on the cover,
     distinct from the steady equalizer that means sound is actually flowing. */
  .quiet-music-player.is-buffering .quiet-music-art {
    animation: quiet-music-breathe 1.1s ease-in-out infinite;
  }

  @keyframes quiet-music-breathe {
    0%,
    100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.045);
    }
  }

  .quiet-music-cover-char {
    grid-area: 1 / 1;
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1;
    color: oklch(1 0 0 / 0.94);
    text-shadow: 0 0.1rem 0.35rem oklch(0 0 0 / 0.25);
    user-select: none;
  }

  .quiet-music-player.is-playing .quiet-music-cover-char {
    opacity: 0;
  }

  .quiet-music-eq {
    grid-area: 1 / 1;
    display: none;
    align-items: flex-end;
    gap: 2.5px;
    height: 1.1rem;
  }

  .quiet-music-eq span {
    width: 3px;
    border-radius: 1.5px;
    background: oklch(1 0 0 / 0.92);
    transform: scaleY(0.4);
  }

  .quiet-music-eq span:nth-child(1) { height: 45%; }
  .quiet-music-eq span:nth-child(2) { height: 85%; }
  .quiet-music-eq span:nth-child(3) { height: 60%; }

  .quiet-music-player.is-playing .quiet-music-eq {
    display: flex;
  }

  .quiet-music-player.is-playing:not(.is-buffering) .quiet-music-eq span {
    animation: quiet-music-eq-bounce 1s ease-in-out infinite;
  }

  .quiet-music-player.is-playing:not(.is-buffering) .quiet-music-eq span:nth-child(1) { animation-delay: -0.4s; }
  .quiet-music-player.is-playing:not(.is-buffering) .quiet-music-eq span:nth-child(2) { animation-delay: -0.1s; }
  .quiet-music-player.is-playing:not(.is-buffering) .quiet-music-eq span:nth-child(3) { animation-delay: -0.65s; }

  @keyframes quiet-music-eq-bounce {
    0%,
    100% {
      transform: scaleY(0.4);
    }

    50% {
      transform: scaleY(1);
    }
  }

  .quiet-music-art-scrim {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: oklch(0 0 0 / 0.3);
    color: oklch(1 0 0 / 0.98);
    opacity: 0;
    transition: opacity 140ms ease;
  }

  .quiet-music-art:hover .quiet-music-art-scrim,
  .quiet-music-art:focus-visible .quiet-music-art-scrim {
    opacity: 1;
  }

  /* Touch devices have no hover: keep the glyph visible so the cover still
     reads as the play/pause control. */
  @media (hover: none) {
    .quiet-music-art-scrim {
      opacity: 1;
      background: linear-gradient(to top, oklch(0 0 0 / 0.38), oklch(0 0 0 / 0.05) 65%);
    }
  }

  .quiet-music-art-icon {
    width: 1.2rem;
    height: 1.2rem;
  }

  .quiet-music-art-play {
    transform: translateX(1px);
  }

  .quiet-music-art-pause {
    display: none;
  }

  .quiet-music-player.is-playing .quiet-music-art-play {
    display: none;
  }

  .quiet-music-player.is-playing .quiet-music-art-pause {
    display: block;
  }

  .quiet-music-copy {
    min-width: 0;
  }

  .quiet-music-heading {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.45rem;
    overflow: hidden;
    white-space: nowrap;
    margin-top: 0.25rem;
    font-size: 0.68rem;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .quiet-music-state {
    min-width: 0;
    overflow: hidden;
    color: var(--qm-ink-soft);
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
  }

  .quiet-music-track {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.05rem;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .quiet-music-title,
  .quiet-music-artist {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .quiet-music-title {
    color: var(--qm-ink);
    font-weight: 600;
  }

  .quiet-music-artist {
    color: var(--qm-ink-soft);
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .quiet-music-volume {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .quiet-music-volume-button {
    display: grid;
    width: 1.1rem;
    height: 1.1rem;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: var(--qm-ink-soft);
    background: transparent;
    cursor: pointer;
    transition: color 160ms ease, transform 160ms ease;
  }

  .quiet-music-volume-button:hover,
  .quiet-music-volume-button:focus-visible {
    color: var(--qm-accent);
    transform: scale(1.08);
  }

  .quiet-music-volume-button:focus-visible {
    outline: 1px solid oklch(from var(--qm-accent) l c h / 0.6);
    outline-offset: 0.18rem;
  }

  .quiet-music-volume-icon {
    width: 1.05rem;
    height: 1.05rem;
    overflow: visible;
  }

  .quiet-music-volume-muted {
    display: none;
  }

  .quiet-music-player.is-muted .quiet-music-volume-high {
    display: none;
  }

  .quiet-music-player.is-muted .quiet-music-volume-muted {
    display: block;
  }

  .quiet-music-volume-range {
    position: absolute;
    inset: 50% 0 auto;
    z-index: 2;
    width: 3.5rem;
    height: 1.25rem;
    margin: 0;
    appearance: none;
    background: transparent;
    opacity: 0;
    transform: translateY(-50%);
    cursor: pointer;
  }

  .quiet-music-volume-slider {
    position: relative;
    display: block;
    width: 3.5rem;
    height: 1.25rem;
  }

  .quiet-music-volume-track,
  .quiet-music-volume-fill {
    position: absolute;
    top: 50%;
    left: 0;
    display: block;
    width: 100%;
    height: 0.175rem;
    border-radius: 999px;
    background: var(--qm-hairline);
    transform: translateY(-50%);
  }

  .quiet-music-volume-fill {
    width: 70%;
    background: var(--qm-accent);
    transform: translateY(-50%);
    /* No width transition: the slider updates continuously while dragging, so
       a transition only makes the fill lag behind the pointer. */
  }

  .quiet-music-volume-range::-webkit-slider-thumb {
    opacity: 0;
  }

  .quiet-music-volume-range::-moz-range-track {
    background: transparent;
  }

  .quiet-music-volume-range::-moz-range-thumb {
    opacity: 0;
  }

  .quiet-music-volume-range:focus-visible {
    outline: 1px solid oklch(from var(--qm-accent) l c h / 0.7);
    outline-offset: 0.15rem;
  }

  /* Hairline scrubber, same 3px treatment as the room page. */
  .quiet-music-progress {
    display: block;
    width: 100%;
    height: 0.5rem;
    margin-top: 0.4rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    touch-action: none;
    user-select: none;
  }

  .quiet-music-progress::before {
    content: '';
    display: block;
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: var(--qm-hairline);
  }

  .quiet-music-progress-fill {
    display: block;
    width: 100%;
    height: 3px;
    margin-top: -3px;
    border-radius: 999px;
    background: var(--qm-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 100ms linear;
  }

  .quiet-music-player.is-seeking .quiet-music-progress-fill {
    transition: none;
  }

  .quiet-music-player.is-error .quiet-music-state {
    color: var(--qm-accent);
  }

  @media (max-width: 420px) {
    .quiet-music-player {
      grid-template-columns: 3rem minmax(0, 1fr);
      column-gap: 0.65rem;
      padding-inline: 0.6rem;
    }

    .quiet-music-art-wrap {
      width: 3rem;
      height: 3rem;
    }

    .quiet-music-cover-char {
      font-size: 1.35rem;
    }

    .quiet-music-volume-range {
      width: 2.75rem;
    }

    .quiet-music-volume-slider {
      width: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quiet-music-player.is-buffering .quiet-music-art,
    .quiet-music-player.is-playing:not(.is-buffering) .quiet-music-eq span {
      animation: none;
    }

    .quiet-music-player.is-playing:not(.is-buffering) .quiet-music-eq span {
      transform: scaleY(1);
    }

    .quiet-music-art,
    .quiet-music-art-scrim,
    .quiet-music-volume-button,
    .quiet-music-progress-fill {
      transition: none;
    }
  }
</style>

<script>
  function formatTime(seconds: number) {
    if (!Number.isFinite(seconds) || seconds < 0) {
      return '0:00'
    }
    const minutes = Math.floor(seconds / 60)
    const remainder = Math.floor(seconds % 60)
    return `${minutes}:${String(remainder).padStart(2, '0')}`
  }

  // The player sits inside <footer transition:persist="music-player">, so the
  // same DOM node (and its playing <audio>) survives ClientRouter navigations.
  // This bundled module script therefore runs exactly once per session; the
  // dataset guard keeps re-binding attempts after swaps from stacking
  // duplicate listeners.
  function setupPlayer() {
    const player = document.querySelector<HTMLElement>('.quiet-music-player')
    const audio = player?.querySelector<HTMLAudioElement>('.quiet-music-audio')
    if (!player || !audio || player.dataset.musicReady === 'true') {
      return
    }

    const playButton = player.querySelector<HTMLButtonElement>('.quiet-music-art')
    const stateLabel = player.querySelector<HTMLElement>('.quiet-music-state')
    const progress = player.querySelector<HTMLButtonElement>('.quiet-music-progress')
    const progressFill = player.querySelector<HTMLElement>('.quiet-music-progress-fill')
    const volumeButton = player.querySelector<HTMLButtonElement>('.quiet-music-volume-button')
    const volumeRange = player.querySelector<HTMLInputElement>('.quiet-music-volume-range')
    const volumeFill = player.querySelector<HTMLElement>('.quiet-music-volume-fill')
    if (!playButton || !stateLabel || !progress || !progressFill || !volumeButton || !volumeRange || !volumeFill) {
      return
    }

    let volume = 0.7
    let previousVolume = volume
    let muted = false
    let hasError = false
    let isSeeking = false

    try {
      const savedVolume = Number.parseFloat(localStorage.getItem('quiet-world-music-volume') || '')
      if (Number.isFinite(savedVolume)) {
        volume = Math.max(0, Math.min(1, savedVolume))
        previousVolume = volume || 0.7
      }
    }
    catch {
      // Storage may be unavailable in private browsing contexts.
    }

    audio.volume = volume
    // Attach the source after the page settles: with preload="metadata" the
    // browser fetches only track headers, so the total duration shows without
    // waiting for the first play tap. Deferring it keeps the first seconds of
    // page load free for fonts, CSS and content — especially on slow mobile
    // networks where the R2 round-trip would otherwise compete up front.
    if (!audio.src) {
      const attach = () => {
        if (!audio.src) {
          audio.src = player.dataset.musicUrl || ''
        }
      }
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(attach, { timeout: 4000 })
      }
      else {
        setTimeout(attach, 2500)
      }
    }
    player.dataset.musicReady = 'true'

    const update = () => {
      const duration = Number.isFinite(audio.duration) ? audio.duration : 0
      const currentTime = Number.isFinite(audio.currentTime) ? audio.currentTime : 0
      const progressValue = duration > 0 ? (currentTime / duration) * 100 : 0

      player.classList.toggle('is-playing', !audio.paused)
      // Buffering feedback: playing was requested but the stream isn't far
      // enough along yet — the record label breathes instead of just sitting
      // still between the click and the first audible sample.
      player.classList.toggle('is-buffering', !audio.paused && audio.readyState < 3)
      player.classList.toggle('is-error', hasError)
      player.classList.toggle('is-muted', muted || volume === 0)
      playButton.setAttribute('aria-label', audio.paused
        ? player.dataset.labelPlay || ''
        : player.dataset.labelPause || '')
      stateLabel.textContent = hasError
        ? player.dataset.labelError || ''
        : `${formatTime(currentTime)} / ${formatTime(duration)}`
      progressFill.style.transform = `scaleX(${progressValue / 100})`
      volumeFill.style.width = `${volume * 100}%`
      progress.setAttribute('aria-valuenow', String(Math.round(progressValue)))
      volumeButton.setAttribute('aria-label', muted || volume === 0
        ? player.dataset.labelUnmute || ''
        : player.dataset.labelMute || '')
      volumeRange.value = String(Math.round(volume * 100))
      volumeRange.setAttribute('aria-valuenow', String(Math.round(volume * 100)))
    }

    playButton.addEventListener('click', async () => {
      if (!audio.src) {
        audio.src = player.dataset.musicUrl || ''
      }

      if (audio.paused) {
        try {
          hasError = false
          await audio.play()
        }
        catch {
          hasError = true
          update()
        }
      }
      else {
        audio.pause()
      }
    })

    const seekFromClientX = (clientX: number) => {
      if (!audio.duration) {
        return
      }
      const rect = progress.getBoundingClientRect()
      const percent = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width))
      audio.currentTime = percent * audio.duration
      update()
    }

    progress.addEventListener('click', (event) => {
      if (!isSeeking) {
        seekFromClientX(event.clientX)
      }
    })

    progress.addEventListener('pointerdown', (event) => {
      if (!audio.duration) {
        return
      }
      isSeeking = true
      player.classList.add('is-seeking')
      progress.setPointerCapture?.(event.pointerId)
      seekFromClientX(event.clientX)
      event.preventDefault()
    })

    progress.addEventListener('pointermove', (event) => {
      if (isSeeking) {
        seekFromClientX(event.clientX)
        event.preventDefault()
      }
    })

    const finishSeeking = (event: PointerEvent) => {
      if (!isSeeking) {
        return
      }
      seekFromClientX(event.clientX)
      isSeeking = false
      player.classList.remove('is-seeking')
      progress.releasePointerCapture?.(event.pointerId)
    }

    progress.addEventListener('pointerup', finishSeeking)
    progress.addEventListener('pointercancel', finishSeeking)

    volumeButton.addEventListener('click', () => {
      if (muted || volume === 0) {
        volume = previousVolume || 0.7
        muted = false
        audio.muted = false
        audio.volume = volume
      }
      else {
        previousVolume = volume
        muted = true
        audio.muted = true
      }
      update()
    })

    volumeRange.addEventListener('input', () => {
      volume = Number(volumeRange.value) / 100
      muted = volume === 0
      if (volume > 0) {
        previousVolume = volume
      }
      audio.muted = false
      audio.volume = volume
      try {
        localStorage.setItem('quiet-world-music-volume', String(volume))
      }
      catch {
        // Storage may be unavailable in private browsing contexts.
      }
      update()
    })

    audio.addEventListener('timeupdate', update)
    audio.addEventListener('loadedmetadata', update)
    audio.addEventListener('waiting', update)
    audio.addEventListener('canplay', update)
    audio.addEventListener('play', () => {
      hasError = false
      update()
    })
    audio.addEventListener('pause', update)
    audio.addEventListener('ended', update)
    audio.addEventListener('error', () => {
      hasError = true
      update()
    })

    update()
  }

  function syncPlayerLanguage() {
    const player = document.querySelector<HTMLElement>('.quiet-music-player')
    if (!player) {
      return
    }

    const language = document.documentElement.lang.toLowerCase()
    const isEnglish = language.startsWith('en')
    const nextLabels = isEnglish
      ? {
          play: 'Play music',
          pause: 'Pause music',
          progress: 'Music progress',
          volume: 'Volume',
          mute: 'Mute music',
          unmute: 'Restore music volume',
          loadError: 'Unable to load this track',
          region: 'Music player',
        }
      : {
          play: '播放音乐',
          pause: '暂停音乐',
          progress: '音乐进度',
          volume: '音量',
          mute: '静音',
          unmute: '恢复音量',
          loadError: '音乐加载失败',
          region: '音乐播放器',
        }

    Object.entries(nextLabels).forEach(([key, value]) => {
      player.dataset[`label${key[0].toUpperCase()}${key.slice(1)}`] = value
    })
    player.setAttribute('aria-label', nextLabels.region)
    player.querySelector('.quiet-music-art')?.setAttribute('aria-label', nextLabels.play)
    player.querySelector('.quiet-music-progress')?.setAttribute('aria-label', nextLabels.progress)
    player.querySelector('.quiet-music-volume-range')?.setAttribute('aria-label', nextLabels.volume)
    player.querySelector('.quiet-music-volume-button')?.setAttribute('aria-label', nextLabels.mute)
  }

  setupPlayer()
  document.addEventListener('astro:page-load', setupPlayer)
  document.addEventListener('astro:after-swap', syncPlayerLanguage)
</script>
