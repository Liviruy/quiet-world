{
  "name": "my-blog",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "artist.cc.cd",
      "custom_domain": true
    },
    {
      "pattern": "www.artist.cc.cd",
      "custom_domain": true
    },
    {
      "pattern": "lwjxnp.eu.cc",
      "custom_domain": true
    },
    {
      "pattern": "www.lwjxnp.eu.cc",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    // Serve dist/404.html (with its layout and navigation) for unknown URLs
    // instead of an empty 404 body.
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  "vars": {
    "R2_PUBLIC_BASE": "https://music.artist.cc.cd"
  }
}
