---
import { allLocales } from '@/config'
import { photosets } from '@/data/photos'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getR2LightboxTemplate, getR2OriginalUrl, getR2ThumbnailSrcSet, getR2ThumbnailUrl } from '@/utils/r2-images'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? ui.zh
const pageSubtitle = currentLang === 'en'
  ? 'Recording the quiet moments shaped by light and shadow.'
  : '用光影记录生活的瞬间'
const previousImageLabel = currentLang === 'en' ? 'Previous image' : '上一张'
const nextImageLabel = currentLang === 'en' ? 'Next image' : '下一张'
const renderedPhotosets = photosets.map(set => ({
  ...set,
  images: set.images.map(image => ({
    ...image,
    // Polaroid cards render at ~72-115px, so 320w thumbnails are plenty. The
    // lightbox asks for a rendition sized to its own stage instead of the
    // original — see lightboxUrlFor() in the script below.
    src: getR2ThumbnailUrl(image.path, 320),
    srcset: getR2ThumbnailSrcSet(image.path, [320, 640]),
    lbTemplate: getR2LightboxTemplate(image.path),
    fullSrc: getR2OriginalUrl(image.path),
  })),
}))

---

<Layout>
  <div class="uno-decorative-line" />

  <div class="gallery-page">
    <h1 class="page-title">{currentUI.gallery}</h1>
    <p class="page-subtitle">{pageSubtitle}</p>

    <!-- Timeline -->
    <div class="timeline">
      {
        renderedPhotosets.map((set, idx) => (
          <div
            class="timeline-item"
            style={`--tl-delay: ${Math.min(idx, 3) * 0.1}s`}
          >
            <!-- Timeline line + icon -->
            <div class="timeline-line-wrapper">
              <div class="timeline-icon">
                <span class="timeline-emoji">{set.emoji}</span>
              </div>
            </div>

            <!-- Content -->
            <div class="timeline-content">
              <p class="timeline-date">{set.date}</p>
              <h2 class="timeline-title">{currentLang === 'en' ? set.titleEn : set.title}</h2>
              <p class="timeline-desc">{currentLang === 'en' ? set.descriptionEn : set.description}</p>

              <!-- Polaroid Stack -->
              <div
                class="polaroid-stack"
                data-photoset={idx}
                data-title={currentLang === 'en' ? set.titleEn : set.title}
                data-description={currentLang === 'en' ? set.descriptionEn : set.description}
              >
                {
                  set.images.map((img, imgIdx) => (
                    <div
                      class="polaroid-item"
                      data-photoset={idx}
                      data-index={imgIdx}
                      style={`z-index: ${set.images.length - imgIdx}`}
                    >
                      <div class="polaroid-inner">
                        <img
                          src={img.src}
                          srcset={img.srcset}
                          width={img.w}
                          height={img.h}
                          data-full-src={img.fullSrc}
                          data-lb-template={img.lbTemplate}
                          alt={currentLang === 'en' ? `${set.titleEn} ${imgIdx + 1}` : img.alt}
                          class="polaroid-img"
                          loading={idx === 0 && imgIdx === 0 ? 'eager' : 'lazy'}
                          fetchpriority={idx === 0 && imgIdx === 0 ? 'high' : 'low'}
                          decoding="async"
                          sizes="(max-width: 640px) 76px, 115px"
                        />
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="gallery-lightbox" class="lightbox" aria-hidden="true">
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-card">

      <div class="lightbox-body">
        <div class="lightbox-image-area">
          <div id="lightbox-image-slot" class="lightbox-slider" aria-live="polite"></div>
          <!-- The photo's own left/right halves switch images. tabindex=-1 keeps
               them out of the tab order (ArrowLeft/ArrowRight already work from the
               document) while still naming them to a screen reader. -->
          <button class="lightbox-zone lightbox-zone-prev" type="button" tabindex="-1" data-step="-1" aria-label={previousImageLabel} />
          <button class="lightbox-zone lightbox-zone-next" type="button" tabindex="-1" data-step="1" aria-label={nextImageLabel} />
        </div>
      </div>
      <div class="lightbox-header">
        <div>
          <h3 id="lightbox-title" class="lightbox-card-title"></h3>
          <p id="lightbox-desc" class="lightbox-card-desc"></p>
        </div>
      </div>
      <div class="lightbox-footer">
        <span id="lightbox-counter"></span>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* ── Page Layout ── */
  .gallery-page {
    position: relative;
    z-index: 1;
    padding-bottom: 3rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    letter-spacing: 0.04em;
    background: linear-gradient(to right, oklch(var(--un-preset-theme-colors-primary)), oklch(var(--un-preset-theme-colors-primary) / 0.7));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-subtitle {
    font-size: 0.925rem;
    margin-bottom: 2.5rem;
    opacity: 0.6;
    color: var(--theme-secondary);
  }

  /* ── Timeline ── */
  .timeline {
    position: relative;
  }

  .timeline-item {
    display: flex;
    gap: 0.75rem;
    opacity: 0;
    animation: timelineSlideDown 0.3s ease-out forwards;
    animation-delay: var(--tl-delay, 0s);
  }

  @keyframes timelineSlideDown {
    0% { opacity: 0; transform: translateY(-10px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .timeline-line-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .timeline-line-wrapper::after {
    content: '';
    position: absolute;
    top: 1.75rem;
    bottom: 0;
    left: 50%;
    width: 1px;
    transform: translateX(-0.5px);
    background: oklch(var(--un-preset-theme-colors-secondary) / 0.12);
  }

  .timeline-item:last-child .timeline-line-wrapper::after {
    display: none;
  }

  .timeline-icon {
    position: relative;
    z-index: 10;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .timeline-emoji {
    font-size: 1.25rem;
    line-height: 1;
    display: block;
    user-select: none;
  }

  .timeline-content {
    flex: 1;
    padding-top: 0.125rem;
    padding-bottom: 2rem;
    min-width: 0;
    position: relative;
  }

  .timeline-date {
    font-size: 0.75rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.6);
    margin-top: 0.125rem;
    margin-bottom: 0.25rem;
  }

  .timeline-title {
    font-size: 1rem;
    font-weight: 600;
    margin-top: 0.125rem;
    margin-bottom: 0.25rem;
    color: oklch(var(--un-preset-theme-colors-primary));
  }

  .timeline-desc {
    font-size: 0.875rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.75);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .timeline-date {
      position: absolute;
      right: 0;
      top: 0.25rem;
      margin-top: 0;
    }

    .timeline-title {
      padding-right: 7rem;
    }
  }

  /* ── Polaroid Stack ── */
  .polaroid-stack {
    position: relative;
    perspective: 1000px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-left: 0.5rem;
    min-height: 5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.5rem;
  }

  .polaroid-item {
    display: inline-block;
    position: relative;
    background: #fff;
    border: 1px solid oklch(0 0 0 / 0.08);
    box-shadow: 0 5px 15px oklch(0 0 0 / 0.12);
    cursor: pointer;
    padding: 0.3rem;
    width: 4.5rem;
    height: 6rem;
    margin-left: -1.5rem;
    margin-top: -0.75rem;
    will-change: transform, opacity;
    border-radius: 1px;
    /* Start hidden — JS will animate in */
    opacity: 0;
    transform: translateX(-60px) scale(0) rotate(0deg);
    /* Hover transition (applied after entrance animation completes) */
    transition: box-shadow 0.15s ease;
  }

  .polaroid-item.entered {
    /* After JS animation, transitions are active for hover */
    transition: transform 0.1s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.1s ease;
  }

  /* Hover: first card (index 0) does NOT shift right; others shift 25px */
  /* Only on devices with hover-capable pointer (mouse/trackpad), not touchscreens */
  @media (hover: hover) {
    .polaroid-item:not([data-index="0"]):hover {
      transform: scale(1.2) rotate(0deg) translateX(25px) !important;
      box-shadow: 0 10px 25px oklch(0 0 0 / 0.18);
      z-index: 100 !important;
    }

    .polaroid-item[data-index="0"]:hover {
      transform: scale(1.2) rotate(0deg) translateX(0) !important;
      box-shadow: 0 10px 25px oklch(0 0 0 / 0.18);
      z-index: 100 !important;
    }
  }

  .polaroid-item.is-clicked {
    /* Click state: snap to flat position */
    transform: scale(1) rotate(0deg) translateX(0) !important;
    transition: transform 0.1s ease !important;
    z-index: -1 !important;
  }

  .polaroid-inner {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: oklch(0.95 0 0);
    border-radius: 1px;
  }

  .polaroid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 640px) {
    .polaroid-item {
      width: 5.5rem;
      height: 7.5rem;
      padding: 0.35rem;
      margin-left: -1.5rem;
      margin-top: -0.75rem;
    }
    .polaroid-stack {
      margin-left: 0.75rem;
    }
  }

  @media (min-width: 1024px) {
    .polaroid-item {
      width: 6rem;
      height: 8rem;
      padding: 0.4rem;
      margin-left: -1.75rem;
      margin-top: -1rem;
    }
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 1.5rem;
    }
  }

  /* ── Reduced Motion ── */
  @media (prefers-reduced-motion: reduce) {
    .timeline-item {
      opacity: 1;
      animation: none;
    }

    .polaroid-item {
      opacity: 1;
      transition: box-shadow 0.15s ease;
    }

    .lightbox-card,
    .lightbox-backdrop,
    .lb-card,
    .lb-photo {
      transition: none;
    }
  }

  /* ── Dark Mode ── */
  html.dark .polaroid-item {
    background: oklch(0.25 0 0);
    border-color: oklch(0.3 0 0);
    box-shadow: 0 5px 15px oklch(0 0 0 / 0.3);
  }

  html.dark .polaroid-item:hover,
  html.dark .polaroid-item.entered:hover {
    box-shadow: 0 10px 25px oklch(0 0 0 / 0.4);
  }

  html.dark .polaroid-inner {
    background: oklch(0.2 0 0);
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
  }

  .lightbox.active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: oklch(0 0 0 / 0.5);
    cursor: zoom-out;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .lightbox.active .lightbox-backdrop {
    opacity: 1;
  }

  .lightbox-card {
    position: relative;
    z-index: 1;
    background: oklch(var(--un-preset-theme-colors-background));
    box-shadow: 0 25px 50px oklch(0 0 0 / 0.25);
    width: 100%;
    max-width: 36rem;
    padding: 1.5rem;
    opacity: 0;
    transform: translateY(60px) scale(0.9);
    transition: opacity 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .lightbox.active .lightbox-card {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  html.dark .lightbox-card {
    background: oklch(0.15 0 0);
  }

  .lightbox-body {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-image-area {
    position: relative;
    /* Anchor for the tap zones, which span the stage's left/right halves.
       Also the drag surface: no browser gesture and no text selection while a
       card is being pulled across it. */
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
    user-select: none;
  }

  /* One constant frame on phones, same as the fixed stage ≥1024px below. A
     per-photo frame (aspect-ratio: var(--lb-ratio)) made the card 324px tall for
     a 16:9 shot and 620px for a 2:3 one, so swiping between them visibly dragged
     the whole card up and down. 3/2 is the ratio of 10 of the 15 photos here, so
     most fill the frame outright; the two portraits get the blurred backing on
     either side, which is how the desktop stage already handles them.
     max-height is the real limit on a phone held sideways. */
  .lightbox-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    height: auto;
    max-height: min(70vh, 34rem);
    overflow: hidden;
  }

  /* ≥1024px keeps the fixed stage: there is room for the letterbox, and a
     frame that never changes size lets the arrows and caption stay put. */
  @media (min-width: 1024px) {
    .lightbox-slider {
      /* 11.5rem subtracts the card's own chrome (caption, counter, padding
         ≈ 146px) plus the lightbox padding, so the card never runs off-screen. */
      aspect-ratio: auto;
      height: min(34rem, calc(100vh - 11.5rem));
      height: min(34rem, calc(100dvh - 11.5rem));
    }
  }

  /* One card = blurred backing + sharp photo. Two of these stack during a
     swipe: the incoming one sits underneath, the current one is dragged off it
     like the top card of a deck. */
  .lb-card {
    position: absolute;
    inset: 0;
    display: grid;
    /* An explicit track pair, not auto: an auto row grows to the tallest item,
       which makes the images' max-height:100% resolve against their own height
       and lets a portrait photo overflow the stage. */
    grid-template: 100% / 100%;
    place-items: center;
    overflow: hidden;
    transition: transform 0.28s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.28s ease;
  }

  .lb-card.is-top {
    z-index: 1;
  }

  /* The card underneath reads as the next one in the deck: slightly smaller
     and dimmer until it is revealed. */
  .lb-card:not(.is-top) {
    transform: scale(0.94);
    opacity: 0.55;
  }

  /* While the finger is down the card must follow it 1:1 — the CSS-Tricks
     swipe pattern: drop the transition for the drag, put it back on release. */
  .lightbox-slider.is-dragging .lb-card {
    transition: none;
  }

  /* Enlarged, blurred copy of the 320w card thumbnail — already decoded, so it
     paints the stage the instant the lightbox opens. It fills the whole card
     box, so wherever the sharp photo does not reach (a portrait photo in a
     capped stage) the leftover shows this instead of empty card. */
  .lb-backing {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    filter: blur(14px) saturate(1.05) brightness(0.86);
    transform: scale(1.06);
  }

  .lb-photo {
    grid-area: 1 / 1;
    position: relative;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    transition: opacity 0.25s ease;
  }

  /* Tap zones over the photo's left/right halves. No visible chrome: on a phone
     the arrows were two 44px discs sitting on top of the picture, and the
     picture is the whole point of the page.

     touch-action: none is what makes the swipe work at all. Without it the
     browser claims the horizontal gesture the moment the finger moves, fires
     pointercancel, and the card just twitches and snaps back. Nothing needs to
     scroll while the lightbox is open (body overflow is locked), so opting the
     whole stage out of browser gestures is free. */
  .lightbox-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    z-index: 3;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }

  .lightbox-zone-prev { left: 0; }
  .lightbox-zone-next { right: 0; }

  .lightbox-header {
    margin-top: 1.25rem;
  }

  .lightbox-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: oklch(var(--un-preset-theme-colors-primary));
    margin: 0;
  }

  .lightbox-card-desc {
    font-size: 0.8rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.6);
    margin: 0.25rem 0 0 0;
  }


  .lightbox-footer {
    margin-top: 0.75rem;
    text-align: center;
  }

  #lightbox-counter {
    font-size: 0.8rem;
    font-weight: 500;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.5);
  }

  @media (max-width: 640px) {
    .lightbox-card {
      padding: 1rem;
    }
    .lightbox-header {
      margin-top: 0.75rem;
    }
    .lightbox-card-title {
      font-size: 1rem;
    }
    /* Arrow size and inset live in the one <1024px block above; shrinking them
       again here would put the 44px touch target back under a fingertip. */
  }
</style>

<script is:inline data-astro-rerun>
(function () {
  // ── Spring Physics Engine ──
  // Exact match of Framer Motion spring: stiffness=360, damping=20, mass=1
  function computeSpringKeyframes(stiffness, damping, mass, fromVal, toVal, duration, steps) {
    const omega0 = Math.sqrt(stiffness / mass)
    const zeta = damping / (2 * Math.sqrt(stiffness * mass))
    const omega_d = omega0 * Math.sqrt(1 - zeta * zeta)
    const amp = fromVal - toVal
    const sqrt1z2 = Math.sqrt(1 - zeta * zeta)
    const kfs = []
    for (let i = 0; i <= steps; i++) {
      const t = (i / steps) * duration
      const response = Math.exp(-zeta * omega0 * t)
        * (Math.cos(omega_d * t) + (zeta / sqrt1z2) * Math.sin(omega_d * t))
      kfs.push({
        offset: i / steps,
        value: toVal + amp * response,
      })
    }
    return kfs
  }

  // Generate random rotation in [-10, 10] degrees (matching Litos: Math.random() * 20 - 10)
  function randomRotation() {
    return (Math.random() * 20 - 10).toFixed(1)
  }

  // ── Polaroid Entrance Animation ──
  function animatePolaroid(card, rotation, delay) {
    const duration = 0.8 // seconds
    const steps = 60
    const stiffness = 360
    const damping = 20
    const mass = 1

    // Compute spring trajectories
    const xKfs = computeSpringKeyframes(stiffness, damping, mass, -60, 0, duration, steps)
    const scaleKfs = computeSpringKeyframes(stiffness, damping, mass, 0, 1, duration, steps)
    const rotKfs = computeSpringKeyframes(stiffness, damping, mass, 0, rotation, duration, steps)

    // Build WAAPI keyframes
    const waapiKfs = []
    for (let i = 0; i <= steps; i++) {
      const offset = xKfs[i].offset
      const opacity = Math.min(1, offset / 0.6) // opacity ramps up in first 60%
      waapiKfs.push({
        offset,
        transform: `translateX(${xKfs[i].value.toFixed(1)}px) scale(${scaleKfs[i].value.toFixed(4)}) rotate(${rotKfs[i].value.toFixed(1)}deg)`,
        opacity,
      })
    }

    const anim = card.animate(waapiKfs, {
      duration: duration * 1000,
      delay,
      fill: 'forwards',
      easing: 'linear', // spring baked into keyframes
    })

    return anim
  }

  // ── State ──
  const existingController = window.__galleryController
  if (existingController) {
    existingController.init()
    return
  }

  let photosets = []
  let currentSet = -1
  let currentIndex = 0
  let clickedCard = null
  let lightbox = null
  let lightboxImageSlot = null
  let lightboxCounter = null
  let lightboxTitle = null
  let lightboxDesc = null
  let backdrop = null
  let lightboxImageArea = null
  let zones = []
  let observers = []

  function buildIndex() {
    const stacks = document.querySelectorAll('.polaroid-stack')
    photosets = []
    stacks.forEach((stack) => {
      const items = stack.querySelectorAll('.polaroid-item')
      const set = {
        title: stack.getAttribute('data-title') || '',
        description: stack.getAttribute('data-description') || '',
        images: [],
      }
      items.forEach((item) => {
        const img = item.querySelector('img')
        if (img) {
          set.images.push({
            src: img.getAttribute('src'),
            fullSrc: img.getAttribute('data-full-src') || img.getAttribute('src'),
            lbTemplate: img.getAttribute('data-lb-template') || '',
            w: Number(img.getAttribute('width')) || 0,
            h: Number(img.getAttribute('height')) || 0,
            alt: img.getAttribute('alt') || '',
          })
        }
      })
      if (set.images.length > 0)
        photosets.push(set)
    })
  }

  // ── Open ──
  function openLightbox(setIdx, imgIdx) {
    if (setIdx < 0 || setIdx >= photosets.length) {
      return
    }
    currentSet = setIdx
    currentIndex = imgIdx
    renderImage()
    lightbox.classList.add('active')
    lightbox.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
  }

  // ── Close ──
  function closeLightbox() {
    lightbox.classList.remove('active')
    lightbox.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
    // Restore clicked card
    if (clickedCard) {
      clickedCard.classList.remove('is-clicked')
      clickedCard = null
    }
  }

  // ── Render ──
  // The stage is a fixed box, so a photo's displayed width is known before any
  // byte arrives: min(stage width, stage height × aspect) × DPR. Asking the
  // Worker for exactly that bucket is what turns the 320–410 KB original into a
  // 48–140 KB AVIF — this host only pulls ~58 KB/s from Cloudflare, so bytes
  // *are* the wait. Buckets are sent as canonical values on purpose: a bespoke
  // ?w=1056 lands in a distinct edge-cache key and pays its own resize MISS.
  // Mirrors THUMBNAIL_WIDTHS in src/worker.ts / src/utils/r2-images.ts.
  const THUMB_BUCKETS = [320, 480, 640, 960, 1200, 1600]
  // Above the largest bucket (a zoomed-in reader) the original is still the
  // right answer, so the request never upsamples beyond what R2 holds.
  function lightboxUrlFor(photo) {
    if (!photo) {
      return ''
    }
    const fallback = photo.fullSrc || photo.src
    if (!photo.lbTemplate?.includes('{w}')) {
      return photo.lbTemplate || fallback // dev: plain R2 object, width is ignored
    }
    // clientWidth/clientHeight, not getBoundingClientRect(): the card sits at
    // scale(0.9) while the opening transition runs and the URL is picked
    // mid-flight. Layout box ignores the transform. 528/544 are the CSS maxima
    // (36rem card minus padding; min(34rem, 100vh - 11.5rem)) and only apply
    // if the stage has no layout yet.
    const stageW = lightboxImageSlot?.clientWidth || 528
    const stageH = lightboxImageSlot?.clientHeight || 544
    const dpr = Math.min(window.devicePixelRatio || 1, 2)
    const needed = Math.min(stageW, stageH * (photo.w / photo.h)) * dpr
    const bucket = THUMB_BUCKETS.find(width => width >= needed)
    return bucket ? photo.lbTemplate.replace('{w}', String(bucket)) : fallback
  }

  // Nothing is fetched for the lightbox until it is opened, so hidden originals
  // never enter the initial request graph; warm() then starts the transfer on
  // hover and for the neighbouring photos, which are the only ones a reader is
  // likely to swipe to.
  const warmed = new Set()
  function warm(src) {
    if (!src || warmed.has(src)) {
      return
    }
    warmed.add(src)
    const preload = new Image()
    preload.decoding = 'async'
    preload.src = src
  }

  // A card is one photo plus its blurred backing, so the two travel together
  // when the card is dragged or dealt.
  function makeCard(photo) {
    const card = document.createElement('div')
    card.className = 'lb-card is-top'

    const backing = document.createElement('div')
    backing.className = 'lb-backing'
    backing.style.backgroundImage = `url("${photo.src}")`

    const img = document.createElement('img')
    img.className = 'lb-photo'
    img.alt = photo.alt
    img.decoding = 'async'
    img.loading = 'eager'
    // Without this a mouse drag on the photo starts a native HTML5 image drag,
    // which cancels our pointer stream the same way a browser-claimed touch
    // gesture does.
    img.draggable = false
    img.style.opacity = '0'
    // The blurred backing lives under the sharp photo permanently: wherever the
    // photo does not reach (a portrait in a height-capped stage) the soft copy
    // fills it, so the frame never shows empty card. A failed load drops the
    // <img> and leaves the soft version rather than a broken icon.
    img.addEventListener('load', () => {
      img.style.opacity = '1'
    }, { once: true })
    img.addEventListener('error', () => {
      img.remove()
    }, { once: true })

    card.append(backing, img)
    // Built only once the lightbox is open, so hidden R2 images never enter the
    // initial page request graph.
    img.src = lightboxUrlFor(photo)
    return card
  }

  function currentPhoto() {
    const set = photosets[currentSet]
    if (!set) {
      return null
    }
    if (currentIndex < 0) {
      currentIndex = set.images.length - 1
    }
    if (currentIndex >= set.images.length) {
      currentIndex = 0
    }
    return set.images[currentIndex]
  }

  function neighbour(delta) {
    const set = photosets[currentSet]
    if (!set) {
      return null
    }
    const index = currentIndex + delta
    return index >= 0 && index < set.images.length ? set.images[index] : null
  }

  // Stage ratio, caption and arrow state. Separate from the card swap so a deal
  // can retarget the frame while the outgoing card is still flying.
  function applyPhoto() {
    const set = photosets[currentSet]
    const photo = currentPhoto()
    if (!photo || !set) {
      return
    }
    // The stage is a constant box now, so its measured size is the same for
    // every photo and the width bucket below is decided once per viewport.
    warm(lightboxUrlFor(neighbour(1)))
    warm(lightboxUrlFor(neighbour(-1)))
    lightboxCounter.textContent = `${currentIndex + 1} / ${set.images.length}`
    lightboxTitle.textContent = set.title
    lightboxDesc.textContent = set.description
  }

  function renderImage() {
    const photo = currentPhoto()
    if (!photo) {
      return
    }
    applyPhoto()
    setTimeout(() => {
      if (!lightboxImageSlot) {
        return
      }
      lightboxImageSlot.replaceChildren(makeCard(photo))
    }, 80)
  }

  // ── Deal ──
  // The next card waits underneath, slightly smaller and dimmer, like the top of
  // a deck; the current one is flung off with a little rotation and the one
  // beneath settles up. Arrows, keyboard and swipe all commit through here so
  // every route produces the same motion.
  function dealCard(delta) {
    const target = neighbour(delta)
    if (!target || !lightboxImageSlot) {
      return
    }
    const incoming = makeCard(target)
    incoming.classList.remove('is-top')
    lightboxImageSlot.prepend(incoming)
    // Flush styles: without this the browser never paints the "under" state and
    // the card pops in instead of rising.
    void incoming.offsetWidth

    const outgoing = lightboxImageSlot.querySelector('.lb-card.is-top')
    if (outgoing) {
      outgoing.classList.remove('is-top')
      outgoing.style.transform = `translateX(${delta * -115}%) rotate(${delta * -9}deg)`
      outgoing.style.opacity = '0'
      outgoing.style.pointerEvents = 'none'
      setTimeout(() => outgoing.remove(), 340)
    }

    incoming.classList.add('is-top')
    incoming.style.transform = 'scale(1)'
    incoming.style.opacity = '1'
    currentIndex += delta
    applyPhoto()
  }

  function prevImage() {
    if (currentSet >= 0 && currentIndex > 0) {
      dealCard(-1)
    }
  }

  function nextImage() {
    if (currentSet >= 0 && currentIndex < photosets[currentSet].images.length - 1) {
      dealCard(1)
    }
  }

  // ── Swipe ──
  // Pointer Events, so finger, pen and mouse-drag all work. Follows the
  // CSS-Tricks pattern: track dx, move the top card 1:1 with transitions off,
  // then commit past a fraction of the stage width or spring back.
  const SWIPE_THRESHOLD = 0.2
  let drag = null
  let suppressZoneClick = false

  function stageWidth() {
    return lightboxImageSlot?.clientWidth || 1
  }

  function onDragStart(e) {
    // Every new press starts clean: if a previous drag never produced a click
    // (released off-element), its flag must not swallow this tap.
    suppressZoneClick = false
    if (drag || e.button > 0) {
      return
    }
    const top = lightboxImageSlot?.querySelector('.lb-card.is-top')
    if (!top || (photosets[currentSet]?.images.length ?? 0) < 2) {
      return
    }
    drag = {
      id: e.pointerId,
      x: e.clientX,
      y: e.clientY,
      dx: 0,
      delta: 0,
      top,
      under: null,
      started: false,
    }
  }

  function onDragMove(e) {
    if (!drag || e.pointerId !== drag.id) {
      return
    }
    const dx = e.clientX - drag.x
    const dy = e.clientY - drag.y
    if (!drag.started) {
      if (Math.abs(dx) < 6) {
        return
      }
      // A mostly-vertical flick is the reader looking for the page, not a card.
      if (Math.abs(dx) <= Math.abs(dy)) {
        drag = null
        return
      }
      drag.delta = dx < 0 ? 1 : -1
      drag.started = true
      // A swipe ends on the same element it started on, so the browser also
      // delivers a click — that click must not deal a second card.
      suppressZoneClick = true
      lightboxImageSlot.classList.add('is-dragging')
      try {
        // Throws if the pointer was already lifted; the drag still works via the
        // listeners on the stage itself.
        lightboxImageSlot.setPointerCapture(e.pointerId)
      }
      catch { /* not capturing */ }
      const target = neighbour(drag.delta)
      if (target) {
        const incoming = makeCard(target)
        incoming.classList.remove('is-top')
        lightboxImageSlot.prepend(incoming)
        drag.under = incoming
      }
    }

    drag.dx = dx
    const width = stageWidth()
    // At either end there is no card beneath, so the deck only stretches a
    // little to say "there is nothing more this way".
    const moved = drag.under ? dx : dx * 0.25
    const progress = Math.min(Math.abs(moved) / width, 1)
    drag.top.style.transform = `translateX(${moved}px) rotate(${moved / width * 6}deg)`
    drag.top.style.opacity = String(1 - progress * 0.2)
    if (drag.under) {
      drag.under.style.transform = `scale(${0.94 + progress * 0.06})`
      drag.under.style.opacity = String(0.55 + progress * 0.45)
    }
  }

  function onDragEnd(e) {
    if (!drag || (e && e.pointerId !== drag.id)) {
      return
    }
    const d = drag
    drag = null
    lightboxImageSlot?.classList.remove('is-dragging')
    if (!d.started) {
      return
    }
    if (d.under && Math.abs(d.dx) > stageWidth() * SWIPE_THRESHOLD) {
      d.top.style.transform = `translateX(${d.delta * -115}%) rotate(${d.delta * -9}deg)`
      d.top.style.opacity = '0'
      d.top.style.pointerEvents = 'none'
      setTimeout(() => d.top.remove(), 340)
      d.under.classList.add('is-top')
      d.under.style.transform = 'scale(1)'
      d.under.style.opacity = '1'
      currentIndex += d.delta
      applyPhoto()
    }
    else {
      d.top.style.transform = ''
      d.top.style.opacity = ''
      d.under?.remove()
    }
  }

  // ── Tap zones ──
  // The photo's left/right halves deal a card. They are real buttons so a screen
  // reader still announces 上一张/下一张, but tabindex=-1 keeps them out of the
  // tab order — the document-level ArrowLeft/ArrowRight handler already covers
  // keyboard use, and a focus stop on an invisible target helps nobody.
  function onZoneClick(e) {
    const zone = e.target instanceof Element ? e.target.closest('.lightbox-zone') : null
    if (!zone) {
      return
    }
    if (suppressZoneClick) {
      suppressZoneClick = false
      return
    }
    if (Number(zone.dataset.step) < 0) {
      prevImage()
    }
    else {
      nextImage()
    }
  }

  // ── Click handler (matches Litos: snap card, then open modal) ──
  function handlePolaroidClick(e) {
    const item = e.currentTarget
    if (item.classList.contains('is-clicked'))
      return

    const setIdx = Number.parseInt(item.getAttribute('data-photoset'), 10)
    const imgIdx = Number.parseInt(item.getAttribute('data-index'), 10)

    // Snap card to flat position (matching Litos clicked state)
    item.classList.add('is-clicked')
    clickedCard = item

    // Open lightbox after 50ms (matching Litos timing)
    setTimeout(() => {
      openLightbox(setIdx, imgIdx)
    }, 50)
  }

  // ── Init Polaroid Entrance with IntersectionObserver ──
  function initPolaroidStacks() {
    const stacks = document.querySelectorAll('.polaroid-stack')
    // Users who ask for reduced motion get the final arrangement immediately —
    // no spring entrance, no observer, no stagger.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    stacks.forEach((stack) => {
      const items = stack.querySelectorAll('.polaroid-item')
      if (items.length === 0)
        return

      // Assign random rotations and attach click handlers
      const rotations = []
      items.forEach((item, idx) => {
        const rot = Number.parseFloat(randomRotation())
        rotations.push(rot)
        item.style.setProperty('--polaroid-r', `${rot}deg`)
        // Set base z-index
        item.style.zIndex = String(items.length - idx)
        // Click handler
        item.addEventListener('click', handlePolaroidClick)
        // Hover (and touchdown, which also fires pointerenter) starts the
        // transfer early, so the photo is usually in flight or in cache by the
        // time the 50ms snap animation ends and the lightbox asks for it.
        item.addEventListener('pointerenter', () => {
          const setIdx = Number(item.getAttribute('data-photoset'))
          const imgIdx = Number(item.getAttribute('data-index'))
          warm(lightboxUrlFor(photosets[setIdx]?.images[imgIdx]))
        }, { passive: true })
      })

      if (reduceMotion) {
        items.forEach((item, idx) => {
          item.style.transform = `translateX(0) scale(1) rotate(${rotations[idx]}deg)`
          item.style.opacity = '1'
          item.classList.add('entered')
        })
        return
      }

      // Use IntersectionObserver (matching Litos: useInView with amount:0.4)
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const stackEl = entry.target
            const cards = stackEl.querySelectorAll('.polaroid-item')
            const picsetIdx = Number.parseInt(stackEl.getAttribute('data-photoset'), 10)

            cards.forEach((card, idx) => {
              // Compute delay: photoset offset + card index offset
              const delay = (picsetIdx * 0.1 + idx * 0.05) * 1000 // ms

              // Start WAAPI spring animation
              const anim = animatePolaroid(card, rotations[idx], delay)

              // When animation finishes, mark as entered and enable CSS transitions for hover
              anim.onfinish = function () {
                card.classList.add('entered')
                // Commit final state and remove animation so hover works
                card.style.transform = `translateX(0) scale(1) rotate(${rotations[idx]}deg)`
                card.style.opacity = '1'
                anim.cancel()
              }
            })

            observer.unobserve(stackEl)
          }
        })
      }, { threshold: 0.4 })

      observer.observe(stack)
      observers.push(observer)
    })
  }

  function cleanup() {
    observers.forEach((observer) => {
      observer.disconnect()
    })
    observers = []

    if (lightbox) {
      if (backdrop)
        backdrop.removeEventListener('click', closeLightbox)
      zones.forEach(zone => zone.removeEventListener('click', onZoneClick))
      if (lightboxImageArea) {
        lightboxImageArea.removeEventListener('pointerdown', onDragStart)
        lightboxImageArea.removeEventListener('pointermove', onDragMove)
        lightboxImageArea.removeEventListener('pointerup', onDragEnd)
        lightboxImageArea.removeEventListener('pointercancel', onDragEnd)
      }
      lightbox.classList.remove('active')
      lightbox.setAttribute('aria-hidden', 'true')
    }
    // A swap mid-drag would otherwise leave the pointer state pointing at
    // elements from the previous page.
    drag = null
    document.removeEventListener('keydown', handleKeydown)
    document.body.style.overflow = ''
    if (clickedCard) {
      clickedCard.classList.remove('is-clicked')
      clickedCard = null
    }
    lightbox = null
    lightboxImageSlot = null
    lightboxCounter = null
    lightboxTitle = null
    lightboxDesc = null
    backdrop = null
    lightboxImageArea = null
    zones = []
    suppressZoneClick = false
    photosets = []
    currentSet = -1
    currentIndex = 0
  }

  function handleKeydown(e) {
    if (!lightbox || !lightbox.classList.contains('active'))
      return
    if (e.key === 'Escape')
      closeLightbox()
    if (e.key === 'ArrowLeft')
      prevImage()
    if (e.key === 'ArrowRight')
      nextImage()
  }

  // ── Init ──
  function init() {
    const nextLightbox = document.getElementById('gallery-lightbox')
    if (!nextLightbox) {
      cleanup()
      return
    }
    if (lightbox === nextLightbox)
      return

    cleanup()
    lightbox = nextLightbox
    lightboxImageSlot = document.getElementById('lightbox-image-slot')
    lightboxCounter = document.getElementById('lightbox-counter')
    lightboxTitle = document.getElementById('lightbox-title')
    lightboxDesc = document.getElementById('lightbox-desc')
    backdrop = lightbox.querySelector('.lightbox-backdrop')
    lightboxImageArea = lightbox.querySelector('.lightbox-image-area')
    zones = [...lightbox.querySelectorAll('.lightbox-zone')]

    buildIndex()
    initPolaroidStacks()

    backdrop.addEventListener('click', closeLightbox)
    zones.forEach(zone => zone.addEventListener('click', onZoneClick))
    // Drag listeners go on the area, not the stage: the tap zones lie on top of
    // it, so a pointerdown there would never bubble to the stage.
    lightboxImageArea.addEventListener('pointerdown', onDragStart)
    lightboxImageArea.addEventListener('pointermove', onDragMove)
    lightboxImageArea.addEventListener('pointerup', onDragEnd)
    lightboxImageArea.addEventListener('pointercancel', onDragEnd)
    document.addEventListener('keydown', handleKeydown)
  }

  window.__galleryController = { init, cleanup }
  document.addEventListener('astro:page-load', init)
  document.addEventListener('astro:before-swap', cleanup)
  init()
})()
</script>
