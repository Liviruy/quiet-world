---
import { allLocales } from '@/config'
import { albums, formatAlbumDate, getAlbumCopy } from '@/data/albums'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getLocalizedPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getR2ImagePath, getR2ThumbnailSrcSet, getR2ThumbnailUrl } from '@/utils/r2-images'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? ui.zh

const pageSubtitle = currentLang === 'en'
  ? 'Recording the roads travelled and the views remembered.'
  : '用镜头记录走过的路，看过的风景'

const localizedAlbumLink = (slug: string) => getLocalizedPath(`/albums/${slug}/`, currentLang)
---

<Layout>
  <div class="uno-decorative-line" />

  <div class="albums-page">
    <h1 class="page-title">{currentUI.travelog}</h1>
    <p class="page-subtitle">{pageSubtitle}</p>

    <!-- Album List -->
    <div class="album-list">
      {
        albums.map((album, index) => {
          const copy = getAlbumCopy(album, currentLang)
          return (
          <article class="album-item group">
            <a href={localizedAlbumLink(album.slug)} class="block" data-astro-prefetch="viewport">
              <div class="flex flex-col items-stretch gap-6 lg:flex-row">
                <!-- Left: Content (2/3) -->
                <div class="flex flex-1 flex-col justify-center lg:w-2/3">
                  <h2 class="mb-3 text-4.5 font-medium transition-colors group-hover:c-primary cjk:tracking-wide">
                    {copy.title}
                  </h2>
                  <p class="line-clamp-2 mb-4 text-3.8 c-secondary leading-relaxed">
                    {copy.description}
                  </p>
                  <div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-3.5 c-secondary">
                    <span class="flex items-center gap-1">
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {copy.location}
                    </span>
                    <time datetime={album.date}>{formatAlbumDate(album.date, currentLang)}</time>
                  </div>
                  <div class="flex flex-wrap items-center gap-x-3 text-3.2 c-secondary/80">
                    {copy.tags.map(tag => (
                      <span>#{tag}</span>
                    ))}
                  </div>
                </div>

                <!-- Right: Image (1/3) -->
                <div class="album-cover relative aspect-[16/9] overflow-hidden rounded-lg lg:w-1/3">
                  <img
                    src={getR2ThumbnailUrl(getR2ImagePath(album.imageId), 640)}
                    srcset={getR2ThumbnailSrcSet(getR2ImagePath(album.imageId), [320, 640])}
                    alt={copy.title}
                    class="album-image h-full w-full object-cover transition-[filter,transform] duration-500 ease-out"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'low'}
                    decoding="async"
                    sizes="(max-width: 1024px) 100vw, 33vw"
                  />
                </div>
              </div>
            </a>

            <!-- Divider -->
            {index < albums.length - 1 && (
              <div class="mt-8 h-px bg-secondary/15"></div>
            )}
          </article>
          )
        })
      }
    </div>
  </div>
</Layout>

<style is:global>
  .albums-page {
    padding-bottom: 3rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    letter-spacing: 0.04em;
    color: var(--theme-primary);
  }

  .page-subtitle {
    font-size: 0.925rem;
    margin-bottom: 2rem;
    opacity: 0.6;
    color: var(--theme-secondary);
  }

  /* ── Album Image Hover ── */
  .album-image {
    filter: grayscale(100%);
  }

  .group:hover .album-image {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  /* ── Divider ── */
  .album-item + .album-item {
    margin-top: 2rem;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .page-title {
      font-size: 1.5rem;
    }
  }
</style>
