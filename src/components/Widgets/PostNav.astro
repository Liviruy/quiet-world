---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import ArrowIcon from '@/assets/icons/go-back.svg'
import HomeIcon from '@/assets/icons/home-icon.svg'
import { getLocalizedPath, getPostPath } from '@/i18n/path'

interface Props {
  newer?: Post | null
  older?: Post | null
  lang: Language
}

const { newer = null, older = null, lang } = Astro.props

const hasNav = Boolean(newer || older)
const homePath = getLocalizedPath('/', lang)
const newerSlug = newer ? (newer.data.abbrlink || newer.id) : ''
const olderSlug = older ? (older.data.abbrlink || older.id) : ''
---

{hasNav && (
  <nav class="post-nav mt-12.6" aria-label="Post navigation">
    <div class="uno-decorative-line" />
    <div class="post-nav-grid">
      {/* Left: newer post = 上一篇 (previous item in the descending post list) */}
      {newer && (
        <a
          class="post-nav-item post-nav-prev"
          href={getPostPath(newerSlug, lang)}
          rel="prev"
          data-astro-prefetch="viewport"
        >
          <span class="post-nav-arrow-wrap">
            <ArrowIcon fill="currentColor" aria-hidden="true" />
          </span>
          <span class="post-nav-title">{newer.data.title}</span>
        </a>
      )}
      {!newer && <span class="post-nav-spacer" />}

      {/* Center: home button */}
      <a class="post-nav-home" href={homePath} aria-label="Back to home">
        <span class="post-nav-home-icon">
          <HomeIcon aria-hidden="true" />
        </span>
      </a>

      {/* Right: older post = 下一篇 (next item in the descending post list) */}
      {older && (
        <a
          class="post-nav-item post-nav-next"
          href={getPostPath(olderSlug, lang)}
          rel="next"
          data-astro-prefetch="viewport"
        >
          <span class="post-nav-title">{older.data.title}</span>
          <span class="post-nav-arrow-wrap post-nav-arrow-right">
            <ArrowIcon fill="currentColor" aria-hidden="true" />
          </span>
        </a>
      )}
      {!older && <span class="post-nav-spacer" />}
    </div>
  </nav>
)}

<style>
  /* Always 3-column grid: left post | home | right post */
  .post-nav-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .post-nav-spacer {
    /* Empty placeholder when one side has no post, keeps grid balanced */
  }
  .post-nav-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .post-nav-prev {
    justify-content: flex-start;
  }
  .post-nav-next {
    justify-content: flex-end;
  }
  /* Arrow wrapper fixes the size; the SVG inside fills it.
     (Astro-imported SVGs can carry inline width/height that override CSS,
     so we constrain the parent box and let the svg be 100% of it.) */
  .post-nav-arrow-wrap {
    flex-shrink: 0;
    display: inline-flex;
    width: 1.1rem;
    height: 1.1rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.6);
    transition: color 0.15s ease-out, transform 0.15s ease-out;
  }
  .post-nav-arrow-wrap :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .post-nav-arrow-right {
    transform: scaleX(-1);
  }
  .post-nav-title {
    color: oklch(var(--un-preset-theme-colors-secondary));
    transition: color 0.15s ease-out;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-nav-next .post-nav-title {
    text-align: right;
  }
  a.post-nav-item:hover .post-nav-title {
    color: oklch(var(--un-preset-theme-colors-primary));
  }
  a.post-nav-item:hover .post-nav-arrow-wrap {
    color: oklch(var(--un-preset-theme-colors-primary));
  }
  a.post-nav-prev:hover .post-nav-arrow-wrap {
    transform: translateX(-3px);
  }
  a.post-nav-next:hover .post-nav-arrow-right {
    transform: scaleX(-1) translateX(-3px);
  }
  /* Home button (center) */
  .post-nav-home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .post-nav-home-icon {
    display: inline-flex;
    width: 1.1rem;
    height: 1.1rem;
    color: oklch(var(--un-preset-theme-colors-secondary) / 0.6);
    transition: color 0.15s ease-out, transform 0.15s ease-out;
  }
  .post-nav-home-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  a.post-nav-home:hover .post-nav-home-icon {
    color: oklch(var(--un-preset-theme-colors-primary));
    transform: scale(1.1);
  }
</style>
